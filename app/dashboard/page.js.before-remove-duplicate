  <div style={{
    height: 6,
    background: "var(--dash-border)",
    borderRadius: 10,
    overflow: "hidden",
    marginBottom: 8,
  }}>
    <div style={{
      height: "100%",
      width: `${(completedTasks.length / 5) * 100}%`,
      background: "#258d7d",
      transition: "width .2s",
    }} />
  </div>

  <p style={{
    fontSize: 12,
    color: "var(--dash-muted)",
    margin: "0 0 12px",
  }}>
    {completedTasks.length} of 5 steps completed
  </p>

  {[
    {
      title: "Build your resume",
      description: "Add education, skills, and projects.",
      href: "/resume-builder",
    },
    {
      title: "Analyze your resume",
      description: "Review content and keyword coverage.",
      href: "/resume-analyzer",
    },
    {
      title: "Improve with AI",
      description: "Improve summaries and bullet points.",
      href: "/ai-tools",
    },
    {
      title: "Explore relevant jobs",
      description: "Browse jobs for your target role.",
      href: "/jobs",
    },
    {
      title: "Learn role-specific skills",
      description: "Follow your learning roadmap.",
      href: "/resources",
    },
  ].map((task, index) => (
    <div className="res-list-item" key={task.title}>
      <input
        type="checkbox"
        checked={completedTasks.includes(index)}
        onChange={(event) => {
          const next = event.target.checked
            ? [...completedTasks, index]
            : completedTasks.filter((item) => item !== index);

          setCompletedTasks(next);

          localStorage.setItem(
            `resonanceDashboardProgress:${savedRole}`,
            JSON.stringify(next)
          );
        }}
        aria-label={`Mark ${task.title} complete`}
        style={{
          marginTop: 5,
          accentColor: "#258d7d",
        }}
      />

      <div style={{ flex: 1 }}>
        <strong>{task.title}</strong>
        <span>{task.description}</span>

        <Link
          href={task.href}
          style={{
            display: "inline-block",
            marginTop: 7,
            color: "#329888",
            fontSize: 12,
            fontWeight: 700,
            textDecoration: "none",
          }}
        >
          Open step →
        </Link>
      </div>
    </div>
  ))}
</section>


