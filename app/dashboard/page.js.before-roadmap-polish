      your own pace.
    </p>
    <div className="overview-roadmap-bar">
      <div style={{ width: `${Math.min(100, completedTasks.length / 5 * 100)}%` }} />
    </div>
    <span className="overview-roadmap-count">
      {completedTasks.length} of 5 steps completed
    </span>
    {[
      { title: "Build your resume", href: "/resume-builder" },
      { title: "Analyze your resume", href: "/resume-analyzer" },
      { title: "Improve with AI", href: "/ai-tools" },
      { title: "Explore relevant jobs", href: "/jobs" },
      { title: "Learn role-specific skills", href: "/resources" },
    ].map((task, index) => (
      <label className="overview-check-row" key={task.title}>
        <input
          type="checkbox"
          checked={completedTasks.includes(index)}
          onChange={(event) => {
            const next = event.target.checked
              ? [...completedTasks, index]
              : completedTasks.filter((item) => item !== index);
            setCompletedTasks(next);
            localStorage.setItem(
              `resonanceDashboardProgress:${savedRole}`,
              JSON.stringify(next)
            );
          }}
        />
        <span className="overview-check-title">{task.title}</span>
        <Link
          href={task.href}
          className="overview-check-link"
          onClick={(event) => event.stopPropagation()}
        >
          Open →
        </Link>
      </label>
    ))}
  </article>

  <article className="overview-panel overview-application-panel">
    <span className="overview-kicker">STAY ORGANIZED</span>
    <h2>Application tracker</h2>
    <p>Keep your job-search activity organized in one place.</p>
    <div className="overview-tracker-wrap">
      <ApplicationTracker />
    </div>
    <Link href="/applications" className="overview-application-link">
      View applications <span aria-hidden="true">→</span>
    </Link>
  </article>
</section>
<p className="res-footer">
          RESONANCE | Resume Intelligence Workspace
        </p>
      </div>
    </main>
  );
}
























