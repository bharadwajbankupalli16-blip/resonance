const [completedTasks, setCompletedTasks] = useState([]);


useEffect(() => {
  const saved = localStorage.getItem("resonanceTargetRole");

  if (saved) {
    setJobRole(saved);
    setSavedRole(saved);
  }

  const roleForProgress = saved || "Data Analyst";
  const progressKey = `resonanceDashboardProgress:${roleForProgress}`;

  try {
    const progress = JSON.parse(
      localStorage.getItem(progressKey) || "[]"
    );

    if (Array.isArray(progress)) {
      setCompletedTasks(progress);
    }
  } catch {
    setCompletedTasks([]);
  }
}, []);



