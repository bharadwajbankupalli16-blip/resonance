function saveRole() {
  const previousKey = `resonanceDashboardProgress:${savedRole}`;
  const nextKey = `resonanceDashboardProgress:${jobRole}`;

  localStorage.setItem("resonanceTargetRole", jobRole);

  if (savedRole !== jobRole) {
    const nextProgress = JSON.parse(
      localStorage.getItem(nextKey) || "[]"
    );

    setCompletedTasks(
      Array.isArray(nextProgress) ? nextProgress : []
