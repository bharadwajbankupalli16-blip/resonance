        </section>

        <section className="r-card">
          <h2>Your learning roadmap</h2>
          <p style={{ color: "var(--r-muted)", fontSize: 13 }}>
            {doneCount} of {data.roadmap.length} steps completed for this role
          </p>
          <div className="r-progress">
            <div style={{ width: `${doneCount / data.roadmap.length * 100}%` }} />
          </div>
          {data.roadmap.map((task, index) => (
            <label className="r-task" key={`${role}-${task}`}>
              <input
                type="checkbox"
                checked={completed.includes(`${role}-${index}`)}
                onChange={() => toggleTask(index)}
              />
              <span>{index + 1}. {task}</span>
            </label>
          ))}
        </section>

        <section className="r-card">
          <h2>Project ideas</h2>
          {data.projects.map((project) => (
            <div className="r-task" key={project}>
              <span style={{ color: "#329888" }}>✦</span>
              <span>{project}</span>
            </div>
          ))}
        </section>

        <section className="r-card">
          <h2>Learning resources</h2>
          {data.links.map(([label, url]) => (
            <a
              className="r-link"
              href={url}
              target="_blank"
              rel="noreferrer"
              key={url}
            >
              {label} ↗
            </a>
          ))}
        </section>

        <section className="r-card">
          <h2>Continue your workflow</h2>
          <p className="r-intro">Apply your learning to your resume and job search.</p>
          <p><Link className="r-back" href="/resume-builder">Build resume ↗</Link></p>
          <p><Link className="r-back" href="/resume-analyzer">Analyze resume ↗</Link></p>
          <p><Link className="r-back" href="/jobs">Explore IT jobs ↗</Link></p>
        </section>
