export default function ResourcesPage() {
  const [role, setRole] = useState("Data Analyst");
  const [completed, setCompleted] = useState([]);

  useEffect(() => {
    setRole(localStorage.getItem("resonanceTargetRole") || "Data Analyst");

    try {
      setCompleted(
        JSON.parse(localStorage.getItem("resonanceRoadmapCompleted") || "[]")
      );
    } catch {
      setCompleted([]);
    }
  }, []);

  const data = resourceData[role] || fallbackData;

  function toggleTask(index) {
    const next = completed.includes(`${role}-${index}`)
      ? completed.filter((item) => item !== `${role}-${index}`)
      : [...completed, `${role}-${index}`];

    setCompleted(next);
    localStorage.setItem("resonanceRoadmapCompleted", JSON.stringify(next));
  }

  const doneCount = data.roadmap.filter((_, index) =>
    completed.includes(`${role}-${index}`)
  ).length;

  return (
    <main className="career-resources">
      <style>{`
        .career-resources {
          --r-bg: #f3f7f5;
          --r-card: #fff;
          --r-text: #17332f;
          --r-muted: #71847e;
          --r-border: #dce7e2;
          min-height: 100vh;
          padding: 32px 20px 55px;
          box-sizing: border-box;
          background: var(--r-bg);
          color: var(--r-text);
          font-family: Helvetica, Arial, sans-serif;
        }
        html[data-theme="dark"] .career-resources {
          --r-bg: #0b1e1c;
          --r-card: #142d29;
          --r-text: #edf6f2;
          --r-muted: #b1c5bd;
          --r-border: #29453f;
        }
        .r-wrap { max-width: 1000px; margin: auto; }
        .r-back { color: #329888; text-decoration: none; font-size: 13px; }
        .r-kicker { margin-top: 30px; color: #329888; font-size: 11px; font-weight: 800; letter-spacing: 2px; }
        .r-wrap h1 { font-size: clamp(28px, 5vw, 40px); margin: 9px 0; }
        .r-intro { color: var(--r-muted); line-height: 1.7; }
        .r-card { background: var(--r-card); border: 1px solid var(--r-border); border-radius: 17px; padding: 22px; margin-top: 17px; }
        .r-card h2 { margin: 0 0 15px; font-size: 19px; }
        .r-tags { display: flex; flex-wrap: wrap; gap: 9px; }
        .r-tag { border-radius: 20px; padding: 9px 12px; background: rgba(63,161,144,.13); color: var(--r-text); font-size: 13px; }
        .r-task { display: flex; gap: 12px; align-items: flex-start; padding: 13px 0; border-bottom: 1px solid var(--r-border); line-height: 1.6; }
        .r-task:last-child { border-bottom: 0; }
        .r-task input { margin-top: 4px; accent-color: #329888; }
        .r-progress { height: 7px; border-radius: 20px; background: var(--r-border); overflow: hidden; margin: 12px 0; }
        .r-progress div { height: 100%; background: #329888; transition: width .2s; }
        .r-link { display: block; padding: 13px 0; border-bottom: 1px solid var(--r-border); color: #329888; text-decoration: none; overflow-wrap: anywhere; }
        .r-link:last-child { border-bottom: 0; }
        .r-link:hover { text-decoration: underline; }
      `}</style>

      <div className="r-wrap">
        <section className="r-card">
          <h2>Career preferences</h2>
          <p className="r-intro">Choose the role you are working toward. Your roadmap and resources update for this role.</p>
          <label htmlFor="career-target-role" style={{ display: "block", marginBottom: 8, fontWeight: 700 }}>
            Target job role
          </label>
          <select
            id="career-target-role"
            value={role}
            onChange={(event) => {
              const nextRole = event.target.value;
              setRole(nextRole);
              localStorage.setItem("resonanceTargetRole", nextRole);
            }}
            style={{
              width: "100%",
              maxWidth: 460,
              padding: "12px",
              borderRadius: 10,
              border: "1px solid var(--r-border)",
              background: "var(--r-card)",
              color: "var(--r-text)",
