            {[
              "Data Analyst",
              "Data Scientist",
              "Machine Learning Engineer",
              "Full Stack Developer",
              "Python Developer",
              "Software Developer",
              "Frontend Developer",
              "Backend Developer",
              "AI Engineer",
              "Data Engineer",
              "Cloud Engineer",
              "DevOps Engineer",
              "Cybersecurity Analyst",
              "QA Engineer",
              "Business Analyst",
