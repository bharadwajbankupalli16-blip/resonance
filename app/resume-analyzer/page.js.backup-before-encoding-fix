
"use client";

import { useRef, useState } from "react";
import Link from "next/link";

export default function ResumeAnalyzerPage() {
  const fileInput = useRef(null);
  const [file, setFile] = useState(null);
  const [dragging, setDragging] = useState(false);
  const [text, setText] = useState("");
  const [jobDescription, setJobDescription] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState(null);

  async function readFile(selectedFile) {
    setError("");
    setResult(null);
    setText("");

    if (!selectedFile) return;

    const allowed =
      selectedFile.name.toLowerCase().endsWith(".pdf") ||
      selectedFile.name.toLowerCase().endsWith(".docx");

    if (!allowed) {
      setError("Please select a PDF or DOCX resume.");
      return;
    }

    if (selectedFile.size > 5 * 1024 * 1024) {
      setError("The file is too large. Maximum size is 5 MB.");
      return;
    }

    setFile(selectedFile);
    setBusy(true);

    try {
      let extracted = "";

      if (selectedFile.name.toLowerCase().endsWith(".pdf")) {
        
const pdfjs = await import("pdfjs-dist/legacy/build/pdf.mjs");

// Tell PDF.js where its worker file is located.
pdfjs.GlobalWorkerOptions.workerSrc = "/pdf.worker.mjs";

const buffer = await selectedFile.arrayBuffer();

const pdf = await pdfjs.getDocument({
  data: new Uint8Array(buffer),
  useWorkerFetch: false,
  isEvalSupported: false,
}).promise;

let extractedText = "";

for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
  const page = await pdf.getPage(pageNumber);
  const textContent = await page.getTextContent();

  extractedText +=
    textContent.items
      .map((item) => ("str" in item ? item.str : ""))
      .join(" ") + "\n";
}


setText(extractedText.trim());



        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
          const page = await pdf.getPage(pageNumber);
          const content = await page.getTextContent();
          extracted +=
            content.items.map((item) => item.str || "").join(" ") + "\n";
        }
      } else {
        const mammoth = await import("mammoth/mammoth.browser");
        const buffer = await selectedFile.arrayBuffer();
        const output = await mammoth.extractRawText({ arrayBuffer: buffer });
        extracted = output.value;
      }

      if (!extracted.trim()) {
        setError(
          "No readable text was found. This may be a scanned PDF. Try a text-based PDF or DOCX."
        );
      } else {
        setText(extracted);
      }
    } catch (err) {
      console.error(err);
      setError("We couldn't read this file. Try another PDF or DOCX.");
      setFile(null);
    } finally {
      setBusy(false);
    }
  }

  function analyze() {
    if (!text.trim()) {
      setError("Upload a readable resume before analyzing.");
      return;
    }

    const content = text.toLowerCase();

    const sections = [
      ["Contact details", /@|linkedin|github|phone|mobile/i],
      ["Professional summary", /summary|objective|profile/i],
      ["Education", /education|university|college|degree|bachelor|master/i],
      ["Skills", /skills|technologies|technical expertise/i],
      ["Experience", /experience|employment|internship|work history/i],
      ["Projects", /projects|portfolio/i],
    ].map(([name, pattern]) => ({
      name,
      found: pattern.test(text),
    }));

    const skills = [
      "Python", "Java", "JavaScript", "TypeScript", "SQL",
      "React", "Node.js", "Next.js", "HTML", "CSS",
      "Machine Learning", "Data Analysis", "Pandas", "NumPy",
      "Power BI", "Excel", "AWS", "Azure", "Docker", "Git",
      "PostgreSQL", "MongoDB", "REST API", "Linux",
    ];

    const foundSkills = skills.filter((skill) =>
      new RegExp(
        skill.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
        "i"
      ).test(text)
    );

    const words = text.trim().split(/\s+/).filter(Boolean);
    const bulletCount = text
      .split(/\n/)
      .filter((line) => /^\s*[-•*â–ª]/.test(line)).length;

    const jobWords = jobDescription.toLowerCase().match(
      /\b[a-z][a-z0-9+#.]{2,}\b/g
    ) || [];

    const uniqueJobWords = [...new Set(jobWords)];
    const matchingKeywords = uniqueJobWords.filter((word) =>
      content.includes(word)
    );

    const missingSections = sections
      .filter((section) => !section.found)
      .map((section) => section.name);

    const suggestions = [];

    if (missingSections.length) {
      suggestions.push(
        `Check whether these sections should be added: ${missingSections.join(", ")}.`
      );
    }

    if (bulletCount < 3) {
      suggestions.push(
        "Consider using concise bullet points to describe relevant contributions."
      );
    }

    if (words.length < 150) {
      suggestions.push(
        "Check whether your resume includes enough relevant detail for your experience level."
      );
    }

    if (jobDescription.trim() && matchingKeywords.length < 5) {
      suggestions.push(
        "Review the job requirements and include relevant keywords only when they accurately describe your skills."
      );
    }

    if (!suggestions.length) {
      suggestions.push(
        "Review spelling, dates, consistency, and the accuracy of your achievements."
      );
    }

    const analysisResult = {
  wordCount: words.length,
  bulletCount,
  sections,
  foundSkills,
  matchingKeywords,
  missingSections,
  suggestions,
  keywordScore: uniqueJobWords.length
    ? Math.round(
        (matchingKeywords.length / uniqueJobWords.length) * 100
      )
    : null,
};

setResult(analysisResult);

try {
  localStorage.setItem(
    "resonance-latest-resume-analysis",
    JSON.stringify({
      ...analysisResult,
      analyzedAt: new Date().toISOString(),
    })
  );
} catch (error) {
  console.error("Could not save resume analysis:", error);
}
  }

   
const panel = {
  background: "var(--card, var(--background, #fff))",
  color: "var(--foreground, #183b35)",
  border: "1px solid var(--border, #dce5e2)",
  borderRadius: 18,
  padding: 22,
};

const field = {
  width: "100%",
  boxSizing: "border-box",
  padding: 13,
  borderRadius: 10,
  border: "1px solid var(--border, #dce5e2)",
  background: "var(--background, #fff)",
  color: "var(--foreground, #183b35)",
  font: "inherit",
};


  return (
    <main style={{
      minHeight: "100vh",
      padding: 24,
      background: "var(--background)",
      color: "var(--foreground)",
    }}>
      <style>{`
        .resume-dropzone {
          border: 2px dashed #4b9f91;
          border-radius: 16px;
          padding: 32px 18px;
          text-align: center;
          cursor: pointer;
          background: color-mix(in srgb, #4b9f91 7%, var(--background));
          transition: background .2s, border-color .2s;
        }
        .resume-dropzone:hover,
        .resume-dropzone.is-dragging {
          border-color: #246963;
          background: color-mix(in srgb, #4b9f91 15%, var(--background));
        }
        .resume-action {
          border: 0;
          border-radius: 10px;
          padding: 12px 17px;
          background: #246963;
          color: white;
          font-weight: 700;
          cursor: pointer;
        }
        .resume-action:disabled {
          opacity: .55;
          cursor: not-allowed;
        }
        .resume-muted { opacity: .7; font-size: 13px; }
      `}</style>

      <div style={{ maxWidth: 1100, margin: "0 auto" }}>
        <header style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: 12,
          marginBottom: 32,
        }}>
          <Link href="/dashboard" style={{
            color: "inherit",
            textDecoration: "none",
            fontWeight: 800,
            fontSize: 22,
          }}>
            â† RESONANCE<span style={{ color: "#ef795f" }}>.</span>
          </Link>
          <span className="resume-muted">RESUME INTELLIGENCE</span>
        </header>

        <p style={{
          color: "#49a394",
          fontWeight: 800,
          fontSize: 12,
          letterSpacing: 2,
        }}>
          RESUME TOOLS
        </p>

        <h1 style={{
          fontSize: "clamp(30px, 5vw, 44px)",
          margin: "8px 0",
        }}>
          Resume Analyzer
        </h1>

        <p className="resume-muted" style={{
          fontSize: 15,
          lineHeight: 1.7,
          marginBottom: 28,
        }}>
          Upload your existing resume to extract text, inspect sections,
          and compare it with a target job description.
        </p>

        <section style={panel}>
          <input
            ref={fileInput}
            type="file"
            accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            hidden
            onChange={(event) => readFile(event.target.files?.[0])}
          />

          <div
            role="button"
            tabIndex={0}
            className={`resume-dropzone ${dragging ? "is-dragging" : ""}`}
            onClick={() => fileInput.current?.click()}
            onKeyDown={(event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                fileInput.current?.click();
              }
            }}
            onDragEnter={(event) => {
              event.preventDefault();
              setDragging(true);
            }}
            onDragOver={(event) => {
              event.preventDefault();
              setDragging(true);
            }}
            onDragLeave={(event) => {
              event.preventDefault();
              setDragging(false);
            }}
            onDrop={(event) => {
              event.preventDefault();
              setDragging(false);
              readFile(event.dataTransfer.files?.[0]);
            }}
          >
            <div style={{ fontSize: 42, marginBottom: 12 }}>â‡§</div>
            <h2 style={{ margin: "0 0 8px", fontSize: 20 }}>
              Drag and drop your resume here
            </h2>
            <p className="resume-muted">
              Or click to browse your computer
            </p>
            <span className="resume-muted">PDF or DOCX Â· Maximum 5 MB</span>
          </div>

          {busy && <p role="status">Reading your resume...</p>}

          {file && !busy && (
            <div style={{
              marginTop: 16,
              padding: 14,
              border: "1px solid var(--border, #dce5e2)",
              borderRadius: 12,
              overflowWrap: "anywhere",
            }}>
              <strong>Selected file</strong>
              <p style={{ marginBottom: 0 }}>{file.name}</p>
              <span className="resume-muted">
                {(file.size / 1024).toFixed(1)} KB
              </span>
            </div>
          )}

          {error && (
            <p role="alert" style={{ color: "#d75c50", marginTop: 14 }}>
              {error}
            </p>
          )}

          {text && (
            <div style={{ marginTop: 24 }}>
              <label htmlFor="resume-text" style={{
                display: "block",
                fontWeight: 700,
                marginBottom: 9,
              }}>
                Extracted resume text
              </label>
              <textarea
                id="resume-text"
                value={text}
                onChange={(event) => setText(event.target.value)}
                rows={10}
                style={field}
              />
              <p className="resume-muted">
                Check the extracted text for errors before analyzing.
              </p>
            </div>
          )}

          <div style={{ marginTop: 24 }}>
            <label htmlFor="job-description" style={{
              display: "block",
              fontWeight: 700,
              marginBottom: 9,
            }}>
              Target job description (optional)
            </label>
            <textarea
              id="job-description"
              value={jobDescription}
              onChange={(event) => setJobDescription(event.target.value)}
              rows={5}
              placeholder="Paste the job requirements here to compare keywords..."
              style={field}
            />
          </div>

          <button
            className="resume-action"
            style={{ marginTop: 18 }}
            onClick={analyze}
            disabled={busy || !text.trim()}
          >
            Analyze Resume
          </button>
        </section>

        {result && (
          <section style={{ marginTop: 26 }}>
            <h2>Analysis results</h2>

            <div style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(145px, 1fr))",
              gap: 14,
            }}>
              {[
                ["Word count", result.wordCount],
                ["Bullet points", result.bulletCount],
                ["Detected skills", result.foundSkills.length],
                ["Sections found", `${result.sections.filter((s) => s.found).length}/6`],
                ["Keyword overlap", result.keywordScore === null ? "â€”" : `${result.keywordScore}%`],
              ].map(([label, value]) => (
                <article key={label} style={panel}>
                  <div className="resume-muted">{label}</div>
                  <strong style={{ fontSize: 27, display: "block", marginTop: 8 }}>
                    {value}
                  </strong>
                </article>
              ))}
            </div>

            <div style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 300px), 1fr))",
              gap: 18,
              marginTop: 18,
            }}>
              <article style={panel}>
                <h3>Resume sections</h3>
                {result.sections.map((section) => (
                  <p key={section.name}>
                    <span style={{ color: section.found ? "#299b79" : "#d78651" }}>
                      {section.found ? "âœ“ " : "○ "}
                    </span>
                    {section.name}
                  </p>
                ))}
              </article>

              <article style={panel}>
                <h3>Detected skills</h3>
                {result.foundSkills.length ? (
                  <div style={{ display: "flex", flexWrap: "wrap", gap: 8 }}>
                    {result.foundSkills.map((skill) => (
                      <span key={skill} style={{
                        background: "#dff2e9",
                        color: "#225e4e",
                        padding: "7px 10px",
                        borderRadius: 8,
                        fontSize: 12,
                      }}>
                        {skill}
                      </span>
                    ))}
                  </div>
                ) : (
                  <p>No skills from the built-in list were detected.</p>
                )}

                {jobDescription.trim() && (
                  <>
                    <h3 style={{ marginTop: 22 }}>Overlapping keywords</h3>
                    <p style={{ lineHeight: 1.8 }}>
                      {result.matchingKeywords.join(", ") ||
                        "No overlapping keywords detected."}
                    </p>
                  </>
                )}
              </article>

              <article style={{ ...panel, gridColumn: "1 / -1" }}>
                <h3>Suggestions</h3>
                <ol style={{ lineHeight: 1.8, paddingLeft: 22 }}>
                  {result.suggestions.map((suggestion) => (
                    <li key={suggestion}>{suggestion}</li>
                  ))}
                </ol>
              </article>
            </div>

            <p className="resume-muted" style={{ marginTop: 18, lineHeight: 1.7 }}>
              This is a local, rule-based analysisâ€”not an official ATS score
              or a guarantee of hiring outcomes. Files are read in your browser
              by this page; this implementation does not upload them to a server.
              Scanned PDFs may need OCR, which is not included.
            </p>
          </section>
        )}
      </div>
    </main>
  );
}


